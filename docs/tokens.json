{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "모두의 교실 디자인 스튜디오 시멘틱 토큰. 이름은 shadcn/ui 구조 + 게임 전용 역할(요소 6·반응 3·카드 종류·슬롯). 값은 컨셉별 themes 에서 공급. CSS 변수명 = 경로를 '-' 로 이은 것 (예: color.semantic.element.access → --element-access). 이 게임은 유니버설 디자인이 주제라 토큰 자체가 대비 4.5:1 이상, 고대비 테마는 7:1 이상을 지켜야 한다.",
  "meta": {
    "project": "design-for-all",
    "created": "2026-10-10",
    "stage": "02",
    "chosenTheme": null,
    "author": "Fable 5.1"
  },
  "size": {
    "tap-min": "48px",
    "stage-w": "1280px",
    "stage-h": "800px",
    "preview": "420px",
    "$note": "태블릿·크롬북 가로. 미리보기(제품 레이어 합성) 정사각 420px"
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px"
  },
  "radius": {
    "sm": "{theme.radius.sm}",
    "md": "{theme.radius.md}",
    "lg": "{theme.radius.lg}",
    "full": "9999px"
  },
  "typography": {
    "font": {
      "display": "{theme.font.display}",
      "body": "{theme.font.body}",
      "label": "{theme.font.label}"
    },
    "size": {
      "sm": "16px",
      "base": "20px",
      "lg": "24px",
      "xl": "30px",
      "2xl": "40px",
      "3xl": "56px"
    },
    "scale-large": 1.25,
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.5
    },
    "$note": "5학년·1인 1기기 기준 본문 20px. 16px 은 보조 라벨만. html[data-text=large] 에서 size 전부 ×1.25"
  },
  "shadow": {
    "card": "{theme.shadow.card}",
    "press": "{theme.shadow.press}",
    "focus": "{theme.shadow.focus}",
    "$note": "focus 는 키보드 포커스 링. 어떤 테마도 지우지 않는다"
  },
  "motion": {
    "fast": "150ms",
    "base": "250ms",
    "reaction": "600ms",
    "$note": "prefers-reduced-motion 에서 전부 0ms"
  },
  "color": {
    "semantic": {
      "background": "{theme.background}",
      "foreground": "{theme.foreground}",
      "card": "{theme.card}",
      "card-foreground": "{theme.card-foreground}",
      "popover": "{theme.popover}",
      "popover-foreground": "{theme.popover-foreground}",
      "primary": "{theme.primary}",
      "primary-foreground": "{theme.primary-foreground}",
      "secondary": "{theme.secondary}",
      "secondary-foreground": "{theme.secondary-foreground}",
      "muted": "{theme.muted}",
      "muted-foreground": "{theme.muted-foreground}",
      "accent": "{theme.accent}",
      "accent-foreground": "{theme.accent-foreground}",
      "destructive": "{theme.destructive}",
      "destructive-foreground": "{theme.destructive-foreground}",
      "border": "{theme.border}",
      "input": "{theme.input}",
      "ring": "{theme.ring}",
      "surface": {
        "classroom": "{theme.surface.classroom}",
        "studio": "{theme.surface.studio}",
        "slot": "{theme.surface.slot}",
        "slot-filled": "{theme.surface.slot-filled}",
        "slot-foreground": "{theme.surface.slot-foreground}",
        "link": "{theme.surface.link}",
        "progress": "{theme.surface.progress}",
        "progress-done": "{theme.surface.progress-done}",
        "$note": "교실 배경·조립대·슬롯 빈칸·슬롯 채움·연결선·진행 바. 같은 값이라도 card 와 역할이 달라 나눈다"
      },
      "cardkind": {
        "trouble": "{theme.cardkind.trouble}",
        "trouble-foreground": "{theme.cardkind.trouble-foreground}",
        "case": "{theme.cardkind.case}",
        "case-foreground": "{theme.cardkind.case-foreground}",
        "ref": "{theme.cardkind.ref}",
        "ref-foreground": "{theme.cardkind.ref-foreground}",
        "$note": "불편 카드·사례 카드·참고 카드. 색 + 머리 라벨 글자 + 아이콘 셋을 항상 함께"
      },
      "reaction": {
        "happy": "{theme.reaction.happy}",
        "happy-foreground": "{theme.reaction.happy-foreground}",
        "partial": "{theme.reaction.partial}",
        "partial-foreground": "{theme.reaction.partial-foreground}",
        "unhappy": "{theme.reaction.unhappy}",
        "unhappy-foreground": "{theme.reaction.unhappy-foreground}",
        "$note": "NPC 반응 3. 색만으로 구분 금지 — 표정 그림 + '만족/부분/불만' 글자 동반"
      },
      "element": {
        "purpose": "{theme.element.purpose}",
        "tech": "{theme.element.tech}",
        "function": "{theme.element.function}",
        "beauty": "{theme.element.beauty}",
        "access": "{theme.element.access}",
        "eco": "{theme.element.eco}",
        "$note": "제품 디자인 요소 6: 목적·최신성·기능성·아름다움·누구나 편리·환경. 요소 태그·점수 축·사례 태깅 버튼이 같은 색을 공유. 항상 아이콘+이름 동반 요소색은 아이콘·스와치·막대 전용(그래픽 3:1). 본문 글자색으로 쓰지 않는다 — 글자는 foreground 로"
      }
    }
  },
  "themes": {
    "flat-studio": {
      "$label": "1 카툰 플랫 미니멀 — 밝은 작업실. 큰 타일·굵은 테두리·선명한 요소 6색",
      "font": {
        "display": "'Jua', sans-serif",
        "body": "'Noto Sans KR', sans-serif",
        "label": "'Noto Sans KR', sans-serif"
      },
      "radius": {
        "sm": "8px",
        "md": "14px",
        "lg": "22px"
